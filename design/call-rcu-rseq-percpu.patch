+/*
+ * Enqueue on @crdp: a producer running on the crdp's worker cpu pushes on the
+ * local queue with one rseq critical section (no atomic); anything else --
+ * another cpu, a migration mid-push, a demoted crdp -- takes the wfcq path.
+ * The worker wake-up keeps its full fence on both paths: the rseq push is a
+ * plain store, and the Dekker pairing with the worker's futex needs it.
+ */
+static void _call_rcu(struct rcu_head *head,
+		      void (*func)(struct rcu_head *head),
+		      struct call_rcu_data *crdp)
+{
+#ifdef URCU_CALL_RCU_RSEQ
+	int cpu = crdp->rseq.home_cpu;
+
+	if (cpu >= 0 && rseq_current_cpu_raw() == cpu) {
+		head->func = func;
+		if (!call_rcu_local_push(crdp, &head->next, cpu)) {
+			call_rcu_local_count(crdp, cpu);
+			wake_call_rcu_thread(crdp);
+			if (caa_unlikely(crdp->qlen_cap &&
+					 call_rcu_qlen(crdp) >= crdp->qlen_cap))
+				call_rcu_cut_delay(crdp);
+			return;
+		}
+	}
+#endif
+	_call_rcu_wfcq(head, func, crdp);
