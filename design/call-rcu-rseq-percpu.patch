+/* Callbacks queued and not yet invoked: the wfcq's plus the local queue's. */
+static unsigned long call_rcu_qlen(struct call_rcu_data *crdp)
+{
+	unsigned long qlen = uatomic_load(&crdp->qlen);
+#ifdef URCU_CALL_RCU_RSEQ
+	long local = (long) ((unsigned long) CMM_LOAD_SHARED(crdp->rseq.local_pushed)
+			     + uatomic_load(&crdp->local_pushed_off)
+			     - CMM_LOAD_SHARED(crdp->local_drained));
+
+	if (local > 0)		/* a push is counted after it is visible */
+		qlen += (unsigned long) local;
+#endif
+	return qlen;
