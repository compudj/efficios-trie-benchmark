+/*
+ * Stop every rseq section from committing on @crdp's local queue, so that it
+ * can be drained from any cpu.  Clearing @rseq_ok alone does not do it: a push
+ * past its second compare would still commit -- with a @next naming a chain the
+ * drainer already took, which a later drain would then walk a second time.  The
+ * membarrier aborts every section on @home_cpu; each restarts, reads @rseq_ok
+ * == 0 and takes the wfcq path.  The fork child has no other thread, and a
+ * failed fence there is harmless.
+ */
+static int call_rcu_rseq_test_nofence;	/* mutation arm, test hook only */
+
+static void call_rcu_local_demote(struct call_rcu_data *crdp)
+{
+	uatomic_store(&crdp->rseq.rseq_ok, 0);
+	cmm_smp_mb();
+	if (call_rcu_rseq_test_nofence)
+		return;
+	if (syscall(__NR_membarrier, URCU_CR_MEMBARRIER_CMD_PRIVATE_EXPEDITED_RSEQ,
+		    URCU_CR_MEMBARRIER_CMD_FLAG_CPU, crdp->rseq.home_cpu))
+		(void) syscall(__NR_membarrier,
+			       URCU_CR_MEMBARRIER_CMD_PRIVATE_EXPEDITED_RSEQ, 0, 0);
+}
+
+/* Once demoted and fenced, @local has no rseq writer left: take it plainly. */
+static struct cds_wfcq_node *call_rcu_local_take_demoted(struct call_rcu_data *crdp)
+{
+	struct cds_wfcq_node *chain = CMM_LOAD_SHARED(crdp->rseq.local);
+
+	if (chain)
+		CMM_STORE_SHARED(crdp->rseq.local, NULL);
+	return chain;
+}
+
+/*
+ * The worker's share of a batch.  On @home_cpu: steal.  Off it (a re-pin still
+ * pending, or impossible): demote, then drain plainly; and once home again with
+ * the cpu still ours, promote back -- safe because while demoted nothing but
+ * this thread touched @local.
+ */
+static struct cds_wfcq_node *call_rcu_local_take(struct call_rcu_data *crdp)
+{
+	int home = rseq_current_cpu_raw() == crdp->rseq.home_cpu;
+	struct cds_wfcq_node *chain;
+
+	if (CMM_LOAD_SHARED(crdp->rseq.rseq_ok)) {
+		if (home)
+			return call_rcu_local_steal(crdp);
+		call_rcu_local_demote(crdp);
+	}
+	chain = call_rcu_local_take_demoted(crdp);
+	if (home && !uatomic_load(&crdp->affinity_lost))
+		uatomic_store(&crdp->rseq.rseq_ok, 1, CMM_RELEASE);
+	return chain;
+}
+
+/* Invoke a taken chain oldest first (it is LIFO); returns how many. */
+static unsigned long call_rcu_local_invoke(struct call_rcu_data *crdp,
+					   struct cds_wfcq_node *chain)
+{
+	struct cds_wfcq_node *fifo = NULL, *next;
+	unsigned long n = 0;
+
+	while (chain) {
+		next = chain->next;
+		chain->next = fifo;
+		fifo = chain;
+		chain = next;
+	}
+	for (; fifo; fifo = next) {
+		struct rcu_head *rhp = caa_container_of(fifo, struct rcu_head, next);
+
+		next = fifo->next;		/* before the callback frees it */
+		rhp->func(rhp);
+		n++;
+	}
+	CMM_STORE_SHARED(crdp->local_drained, crdp->local_drained + n);
+	return n;
+}
+
+/*
+ * Move whatever sits on @crdp's local queue onto its wfcq, oldest first, from
+ * any cpu: teardown and fork (the worker is stopped or gone) and the test hook
+ * (workers paused).  Leaves the crdp demoted.
+ */
+static void call_rcu_local_flush(struct call_rcu_data *crdp)
+{
+	struct cds_wfcq_node *chain, *fifo = NULL, *next;
+	unsigned long n = 0;
+
+	if (crdp->rseq.home_cpu < 0)
+		return;
+	call_rcu_local_demote(crdp);
+	chain = call_rcu_local_take_demoted(crdp);
+	while (chain) {
+		next = chain->next;
+		chain->next = fifo;
+		fifo = chain;
+		chain = next;
+	}
+	for (; fifo; fifo = next) {
+		next = fifo->next;
+		cds_wfcq_node_init(fifo);
+		cds_wfcq_enqueue(&crdp->cbs_head, &crdp->cbs_tail, fifo);
+		n++;
+	}
+	if (n) {
+		uatomic_add(&crdp->qlen, n);
+		CMM_STORE_SHARED(crdp->local_drained, crdp->local_drained + n);
+	}
+}
+#else
+static inline int call_rcu_local_empty(struct call_rcu_data *crdp)
+{
+	(void) crdp;
+	return 1;
+}
