# Our own out-of-tree liburcu build (the Fractal Trie); rebuild with `make urcu`
/urcu-build/

# Our liburcu clone on the urcu-txn-dev branch; rebuild with `make urcu-txn`
/urcu-txn-build/
# TSAN-instrumented liburcu (compiler atomic builtins + -fsanitize=thread), for
# experiments/dcache stress-tsan; built by copying + reconfiguring urcu-txn-build.
/urcu-txn-tsan-build/

# Our clean bind9 clone + overlay + build (the MT benchmarks); make bind9
/bind9-src/

# Build artifacts
*.o
*.lo

# Benchmark binaries (built from src/)
/bench_one_st
/bench_wormhole_gpl
/bench_scale_hotrowex
/bench_scale_masstree
/bench_scale_artolc
/bench_scale_artrowex
/bench_list_scale
/bench_list_scale.default
/bench_list_scale.pooled
/bench_txn_3hash
/bench_txn_3skiplist

# Benchmark output / results
/results/
*.data

# dcache experiment build output (binaries + *.o) is ignored by
