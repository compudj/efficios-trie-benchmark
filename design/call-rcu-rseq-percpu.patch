+	call_rcu_lock(&call_rcu_mutex);
+	cds_list_for_each_entry(crdp, &call_rcu_data_list, list) {
+		uatomic_or(&crdp->flags, URCU_CALL_RCU_PAUSE);
+		cmm_smp_mb__after_uatomic_or();
+		wake_call_rcu_thread(crdp);
+	}
+	cds_list_for_each_entry(crdp, &call_rcu_data_list, list)
+		while ((uatomic_load(&crdp->flags) & URCU_CALL_RCU_PAUSED) == 0)
+			(void) poll(NULL, 0, 1);
+	call_rcu_rseq_test_nofence = !fence;
+	cds_list_for_each_entry(crdp, &call_rcu_data_list, list) {
+		call_rcu_local_flush(crdp);
+		if (crdp->rseq.home_cpu >= 0 && !crdp->affinity_lost)
+			uatomic_store(&crdp->rseq.rseq_ok, 1, CMM_RELEASE);
+	}
+	call_rcu_rseq_test_nofence = 0;
+	cds_list_for_each_entry(crdp, &call_rcu_data_list, list)
+		uatomic_and(&crdp->flags, ~URCU_CALL_RCU_PAUSE);
+	cds_list_for_each_entry(crdp, &call_rcu_data_list, list)
+		while ((uatomic_load(&crdp->flags) & URCU_CALL_RCU_PAUSED) != 0)
+			(void) poll(NULL, 0, 1);
+	call_rcu_unlock(&call_rcu_mutex);
+}
+
+/* TEST ONLY: is the local queue in use for @crdp? */
+int urcu_call_rcu_rseq_test_enabled(struct call_rcu_data *crdp)
+{
+	return crdp && crdp->rseq.home_cpu >= 0 &&
+		uatomic_load(&crdp->rseq.rseq_ok);
+}
+
+/* TEST ONLY: pushes @crdp's local queue has taken so far. */
+unsigned long urcu_call_rcu_rseq_test_pushed(struct call_rcu_data *crdp)
+{
+	return crdp ? (unsigned long) CMM_LOAD_SHARED(crdp->rseq.local_pushed) +
+		uatomic_load(&crdp->local_pushed_off) : 0;
+}
+#endif /* URCU_CALL_RCU_RSEQ */
diff --git a/tests/regression/test_call_rcu_rseq.c b/tests/regression/test_call_rcu_rseq.c
new file mode 100644
index 00000000..49d44cb9
--- /dev/null
+++ b/tests/regression/test_call_rcu_rseq.c
@@ -0,0 +1,222 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+/*
+ * test_call_rcu_rseq.c -- exactly-once torture for the call_rcu rseq local
+ * queue (--enable-call-rcu-rseq).
+ *
+ * Per-cpu call_rcu threads; one producer pinned on each of P cpus pushes
+ * uniquely numbered callbacks (they take the rseq local path: on their
+ * worker's cpu), U unpinned producers push too (they migrate, so they hit the
+ * abort and wfcq paths).  A CHAOS thread keeps flushing every local queue from
+ * whatever cpu it runs on -- demote, fence, plain drain, re-enqueue on the
+ * wfcq, promote -- while the pushes are live: the cross-cpu drain teardown and
+ * hotplug perform.  A BARRIER thread pinned on a producer cpu pushes a callback
+ * on the local path and calls rcu_barrier(), which must not return before that
+ * callback ran.
+ *
+ * Every callback must run exactly once.  `nofence` makes the chaos thread skip
+ * the membarrier: the mutation arm, which must fail (a push that committed
+ * after the flush took its chain re-links that chain, and a later drain runs it
+ * again).
+ *
+ * Usage: test_call_rcu_rseq [producer_cpus [unpinned [seconds [nofence]]]]
+ * Exit 0 = exactly once, ordering held, local path used; 1 = anomaly.
+ */
+#define _GNU_SOURCE
+#include <pthread.h>
+#include <sched.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <urcu/urcu-memb.h>
+#include <urcu/uatomic.h>
+
+void urcu_call_rcu_rseq_test_flush_all(int fence);
+int urcu_call_rcu_rseq_test_enabled(struct call_rcu_data *crdp);
+unsigned long urcu_call_rcu_rseq_test_pushed(struct call_rcu_data *crdp);
+
+#define MAX_IDS		(1UL << 27)
+
+struct node {
+	struct rcu_head head;
+	unsigned long id;
+};
+
+static unsigned char *hits;		/* [MAX_IDS] invocation count, saturating */
+static unsigned long next_id;		/* id allocator (chunked) */
+static int stop, fence = 1;
+static unsigned long flushes, barrier_checks, barrier_fail;
+
+static void cb(struct rcu_head *h)
+{
+	struct node *n = caa_container_of(h, struct node, head);
+	unsigned char v = uatomic_add_return(&hits[n->id], 1);
+
+	(void) v;
+	free(n);
+}
+
+static void pin(int cpu)
+{
+	cpu_set_t s;
+
+	CPU_ZERO(&s);
+	CPU_SET(cpu, &s);
+	if (pthread_setaffinity_np(pthread_self(), sizeof(s), &s)) {
+		perror("pthread_setaffinity_np");
+		exit(2);
+	}
+}
+
+static void *producer(void *arg)
+{
+	long cpu = (long) arg;		/* -1: unpinned */
+	unsigned long id = 0, end = 0;
+
+	if (cpu >= 0)
+		pin((int) cpu);
+	urcu_memb_register_thread();
+	while (!uatomic_load(&stop)) {
+		struct node *n;
+
+		if (id == end) {	/* take ids 4096 at a time */
+			id = uatomic_add_return(&next_id, 4096) - 4096;
+			end = id + 4096;
+			if (end > MAX_IDS)
+				break;
+		}
+		n = malloc(sizeof(*n));
+		n->id = id++;
+		urcu_memb_call_rcu(&n->head, cb);
+	}
+	urcu_memb_unregister_thread();
+	return NULL;
+}
+
+static void *chaos(void *arg)
+{
+	(void) arg;
+	while (!uatomic_load(&stop)) {
+		struct timespec ts = { 0, (rand() % 400) * 1000L };
+
+		nanosleep(&ts, NULL);
+		urcu_call_rcu_rseq_test_flush_all(fence);
+		flushes++;
+	}
+	return NULL;
+}
+
+struct flag { struct rcu_head head; int done; };
+
+static void flag_cb(struct rcu_head *h)
+{
+	struct flag *f = caa_container_of(h, struct flag, head);
+
+	uatomic_store(&f->done, 1);
+}
+
+static void *barrier_checker(void *arg)
+{
+	long cpu = (long) arg;
+
+	pin((int) cpu);
+	urcu_memb_register_thread();
+	while (!uatomic_load(&stop)) {
+		struct flag *f = calloc(1, sizeof(*f));
+
+		urcu_memb_call_rcu(&f->head, flag_cb);	/* local: on its cpu */
+		urcu_memb_barrier();
+		if (!uatomic_load(&f->done))
+			barrier_fail++;		/* leak it: it may still run */
+		else
+			free(f);
+		barrier_checks++;
+	}
+	urcu_memb_unregister_thread();
+	return NULL;
+}
+
+int main(int argc, char **argv)
+{
+	int P = argc > 1 ? atoi(argv[1]) : 8;
+	int U = argc > 2 ? atoi(argv[2]) : 4;
+	int secs = argc > 3 ? atoi(argv[3]) : 10;
+	unsigned long i, ids, lost = 0, dup = 0, pushed = 0;
+	pthread_t *pt, ct, bt;
+	int enabled = 0, ncpu = (int) sysconf(_SC_NPROCESSORS_ONLN), ret = 0;
+
+	if (argc > 4 && !strcmp(argv[4], "nofence"))
+		fence = 0;
+	setvbuf(stdout, NULL, _IOLBF, 0);
+	if (P < 1 || P + 2 > ncpu) {
+		fprintf(stderr, "need 1 <= producer_cpus <= ncpu-2\n");
+		return 2;
+	}
+	hits = calloc(MAX_IDS, 1);
+	urcu_memb_register_thread();
+	if (create_all_cpu_call_rcu_data_memb(getenv("TEST_RT") ? URCU_CALL_RCU_RT : 0)) {
+		perror("create_all_cpu_call_rcu_data");
+		return 2;
+	}
+	for (i = 0; i < (unsigned long) P; i++)
+		enabled += urcu_call_rcu_rseq_test_enabled(get_cpu_call_rcu_data_memb((int) i));
+	printf("== test_call_rcu_rseq: %d pinned + %d unpinned producers, %ds, fence=%s; "
+	       "local queue enabled on %d/%d producer cpus\n",
+	       P, U, secs, fence ? "on" : "OFF (mutation arm)", enabled, P);
+
+	pt = calloc(P + U, sizeof(*pt));
+	for (i = 0; i < (unsigned long) (P + U); i++)
+		pthread_create(&pt[i], NULL, producer,
+			       (void *) (long) (i < (unsigned long) P ? (long) i : -1));
+	pthread_create(&ct, NULL, chaos, NULL);
+	pthread_create(&bt, NULL, barrier_checker, (void *) 0L);
+	urcu_memb_unregister_thread();
+	sleep(secs);
+	uatomic_store(&stop, 1);
+	for (i = 0; i < (unsigned long) (P + U); i++)
+		pthread_join(pt[i], NULL);
+	pthread_join(ct, NULL);
+	pthread_join(bt, NULL);
+
+	urcu_memb_register_thread();
+	urcu_memb_barrier();
+	urcu_memb_barrier();
+	for (i = 0; i < (unsigned long) P; i++)
+		pushed += urcu_call_rcu_rseq_test_pushed(get_cpu_call_rcu_data_memb((int) i));
+	ids = uatomic_load(&next_id);
+	if (ids > MAX_IDS)
+		ids = MAX_IDS;
+	/* ids handed out but not used (a producer's unfinished chunk) read 0 */
+	for (i = 0; i < ids; i++) {
+		if (hits[i] > 1)
+			dup++;
+	}
+	/* lost: count zeros below the highest id seen invoked per chunk */
+	for (i = 0; i < ids; i += 4096) {
+		unsigned long j, last = i;
+
+		for (j = i; j < i + 4096 && j < ids; j++)
+			if (hits[j])
+				last = j;
+		for (j = i; j < last; j++)
+			if (!hits[j])
+				lost++;
+	}
+	printf("callbacks: ~%lu issued, %lu pushed on the local path, %lu flushes, "
+	       "%lu barrier checks\n", ids, pushed, flushes, barrier_checks);
+	printf("double-invoked: %lu   lost: %lu   barrier ordering failures: %lu\n",
+	       dup, lost, barrier_fail);
+	if (dup || lost || barrier_fail)
+		ret = 1;
+	if (!enabled || !pushed) {
+		printf("VACUOUS: the local path was never used\n");
+		ret = 1;
+	}
+	printf("RESULT: %s\n", ret ? "FAIL" : "PASS");
+	free_all_cpu_call_rcu_data_memb();
+	urcu_memb_unregister_thread();
+	return ret;
+}
