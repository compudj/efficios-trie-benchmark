+#ifdef URCU_CALL_RCU_RSEQ
+/*
+ * Whether crdps may use the local queue: rseq registered in this process,
+ * membarrier(...PRIVATE_EXPEDITED_RSEQ) registered -- without that fence a
+ * local queue could never be drained from another cpu, so teardown, hotplug
+ * and fork would have no safe way to reach it -- and not disabled with
+ * URCU_CALL_RCU_RSEQ=0.  Decided once, under call_rcu_mutex.
+ */
+static int call_rcu_rseq_state;		/* 0: undecided, 1: on, -1: off */
+
+static int call_rcu_rseq_usable(void)
+{
+	const char *e;
+
+	if (call_rcu_rseq_state)
+		return call_rcu_rseq_state > 0;
+	call_rcu_rseq_state = -1;
+	e = getenv("URCU_CALL_RCU_RSEQ");
+	if (e && !strcmp(e, "0"))
+		return 0;
+	(void) rseq_init();
+	if (!rseq_registered())
+		return 0;
+	if (syscall(__NR_membarrier,
+		    URCU_CR_MEMBARRIER_CMD_REGISTER_PRIVATE_EXPEDITED_RSEQ, 0, 0))
+		return 0;
+	call_rcu_rseq_state = 1;
+	return 1;
+}
+
+static inline int call_rcu_local_empty(struct call_rcu_data *crdp)
+{
+	return crdp->rseq.home_cpu < 0 || !CMM_LOAD_SHARED(crdp->rseq.local);
+}
+
+/* Push @node on @crdp's local queue from @cpu.  0, or -1: take the wfcq path. */
+static inline int call_rcu_local_push(struct call_rcu_data *crdp,
+				      struct cds_wfcq_node *node, int cpu)
+{
+	int attempt;
+
+	for (attempt = 0; attempt < 8; attempt++) {
+		struct cds_wfcq_node *old = CMM_LOAD_SHARED(crdp->rseq.local);
+		int ret;
+
+		node->next = old;		/* unpublished until the commit */
+		ret = rseq_load_cbne_load_cbne_store__ptr(RSEQ_MO_RELAXED,
+				RSEQ_PERCPU_CPU_ID,
+				(intptr_t *) &crdp->rseq.local, (intptr_t) old,
+				&crdp->rseq.rseq_ok, 1, (intptr_t) node, cpu);
+		if (caa_likely(!ret))
+			return 0;
+		if (ret < 0) {			/* aborted */
+			if (rseq_current_cpu_raw() != cpu)
+				return -1;	/* migrated */
+			continue;		/* preempted or signalled */
+		}
+		/* a compare failed: @local moved (retry), or we were demoted */
+		if (!CMM_LOAD_SHARED(crdp->rseq.rseq_ok))
+			return -1;
+	}
+	return -1;
+}
+
+/* Count a local push for the queue-length cap, never with an RMW on @local_pushed. */
+static inline void call_rcu_local_count(struct call_rcu_data *crdp, int cpu)
+{
+	for (;;) {
+		if (!rseq_load_add_store__ptr(RSEQ_MO_RELAXED, RSEQ_PERCPU_CPU_ID,
+					      &crdp->rseq.local_pushed, 1, cpu))
+			return;
+		if (rseq_current_cpu_raw() != cpu) {	/* migrated since the push */
+			uatomic_inc(&crdp->local_pushed_off);
+			return;
+		}
+	}
+}
+
+/*
+ * Worker on @home_cpu: take the whole local queue.  Producers on this cpu are
+ * serialized with it by rseq itself: no atomic, no fence.  Returns the chain,
+ * newest first, or NULL -- also when a demotion beat it or it migrated (the
+ * next pass takes the demoted path).
+ */
+static struct cds_wfcq_node *call_rcu_local_steal(struct call_rcu_data *crdp)
+{
+	int cpu = crdp->rseq.home_cpu;
+
+	for (;;) {
+		struct cds_wfcq_node *old = CMM_LOAD_SHARED(crdp->rseq.local);
+		int ret;
+
+		if (!old)
+			return NULL;
+		ret = rseq_load_cbne_load_cbne_store__ptr(RSEQ_MO_RELAXED,
+				RSEQ_PERCPU_CPU_ID,
+				(intptr_t *) &crdp->rseq.local, (intptr_t) old,
+				&crdp->rseq.rseq_ok, 1, 0, cpu);
+		if (!ret)
+			return old;
+		if (ret < 0 && rseq_current_cpu_raw() != cpu)
+			return NULL;
+		if (ret > 0 && !CMM_LOAD_SHARED(crdp->rseq.rseq_ok))
+			return NULL;
+	}
+}
